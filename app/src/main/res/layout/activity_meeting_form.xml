<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5FB"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEETING MINUTES BOOK"
            android:textColor="#6366A5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Meeting Details"
            android:textColor="#202750"
            android:textSize="30sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capture the important points, decisions, and next steps."
            android:textColor="#737B93"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="22dp" />

        <!-- Basic information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/meeting_card_background"
            android:padding="18dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BASIC INFORMATION"
                android:textColor="#414B78"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Meeting title"
                android:textColor="#293252"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtTitle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="e.g. Project Review Meeting"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#202750"
                android:textColorHint="#969DB0"
                android:textSize="15sp"
                android:background="@drawable/meeting_input_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Meeting date"
                android:textColor="#293252"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="DD-MM-YYYY"
                android:inputType="text"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#202750"
                android:textColorHint="#969DB0"
                android:textSize="15sp"
                android:background="@drawable/meeting_input_background" />

        </LinearLayout>

        <!-- Discussion and decisions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/meeting_card_background"
            android:padding="18dp"
            android:elevation="2dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MEETING NOTES"
                android:textColor="#414B78"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="#293252"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:hint="What was discussed in the meeting?"
                android:inputType="textCapSentences|textMultiLine"
                android:gravity="top|start"
                android:padding="14dp"
                android:textColor="#202750"
                android:textColorHint="#969DB0"
                android:textSize="15sp"
                android:background="@drawable/meeting_input_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Decisions made"
                android:textColor="#293252"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtDecisions"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:hint="What did everyone agree on?"
                android:inputType="textCapSentences|textMultiLine"
                android:gravity="top|start"
                android:padding="14dp"
                android:textColor="#202750"
                android:textColorHint="#969DB0"
                android:textSize="15sp"
                android:background="@drawable/meeting_input_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Action items"
                android:textColor="#293252"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtActions"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Tasks, responsible persons, and deadlines"
                android:inputType="textCapSentences|textMultiLine"
                android:gravity="top|start"
                android:padding="14dp"
                android:textColor="#202750"
                android:textColorHint="#969DB0"
                android:textSize="15sp"
                android:background="@drawable/meeting_input_background" />

        </LinearLayout>

        <!-- Save button -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="28dp"
            android:text="Save Meeting"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3949AB"
            android:stateListAnimator="@null"
            android:elevation="3dp" />

    </LinearLayout>

</ScrollView>
